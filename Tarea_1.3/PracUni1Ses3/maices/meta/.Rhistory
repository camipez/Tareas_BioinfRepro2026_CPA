})
if (!is.null(res)) {
## COLUMNAS: ONTOLOGY (BP/MF/CC), TERM (nombre), N (genes del termino
## presentes en el array), DE (cuantos estan en tu lista), P.DE (p) y
## FDR (corregido) <- el que importa.
res$modo <- modo
print(utils::head(res, 10))
resultados_go[[paste(cf, col, sep = "_")]] <- res
write.csv(res, file.path(DIRS$tab,
paste0("12_", col, "_", gsub("[^A-Za-z0-9]", "_", cf), ".csv")),
row.names = TRUE)
}
}
}
saveRDS(resultados_go, file.path(DIRS$proc, "12_enriquecimiento.rds"))
} else if (HACER_ENRIQUEC) {
msg("Enriquecimiento omitido (plataforma no soportada, o sin resultados).",
nivel = "warn")
}
if (length(resultados_dmp)) {
for (cf in names(resultados_dmp)) {
tt  <- resultados_dmp[[cf]]$tabla
lam <- resultados_dmp[[cf]]$lambda
sufijo <- gsub("[^A-Za-z0-9]", "_", cf)
## --- 13.1 Volcano ---------------------------------------------------------
vol <- tt
vol$categoria <- ifelse(vol$adj.P.Val < FDR_CUT & abs(vol$delta_beta) > DELTA_BETA_CUT,
"FDR y magnitud",
ifelse(vol$adj.P.Val < FDR_CUT, "Solo FDR", "No significativo"))
vol$etiqueta <- ifelse(rank(vol$P.Value, ties.method = "first") <= 15,
rownames(vol), "")
p_vol <- ggplot(vol, aes(x = delta_beta, y = -log10(P.Value), color = categoria)) +
geom_point(alpha = 0.5, size = 0.9) +
scale_color_manual(values = c("No significativo" = "grey72",
"Solo FDR" = "#D9A441",
"FDR y magnitud" = "#8E3B2E")) +
geom_vline(xintercept = c(-DELTA_BETA_CUT, DELTA_BETA_CUT),
linetype = "dashed", color = "grey45") +
ggrepel::geom_text_repel(aes(label = etiqueta), size = 2.4,
max.overlaps = 25, show.legend = FALSE) +
labs(title = paste0("Volcano plot - ", cf),
subtitle = paste0(resultados_dmp[[cf]]$descripcion_db,
" | plataforma ", PLAT$sesame, " | modelo: ", formula_txt),
x = "Delta beta", y = "-log10(p sin corregir)", color = NULL) +
theme_bw(base_size = 12)
guardar_fig(p_vol, paste0("13_volcano_", sufijo, ".png"), w = 9.5, h = 7)
## --- 13.2 QQ plot y lambda -----------------------------------------------
## Se dibuja sin depender de paquetes externos, para que funcione siempre.
p_obs <- sort(tt$P.Value[!is.na(tt$P.Value)])
p_esp <- stats::ppoints(length(p_obs))
qq_df <- data.frame(esperado = -log10(p_esp), observado = -log10(p_obs))
## Se dibuja una submuestra de los puntos no significativos para que el
## archivo no pese decenas de megabytes.
if (nrow(qq_df) > 50000) {
keep_qq <- c(seq_len(5000), sample(5001:nrow(qq_df), 45000))
qq_df <- qq_df[sort(keep_qq), ]
}
p_qq <- ggplot(qq_df, aes(x = esperado, y = observado)) +
geom_abline(slope = 1, intercept = 0, color = "#8E3B2E", linetype = "dashed") +
geom_point(size = 0.7, alpha = 0.6, color = "#3C4F76") +
labs(title = paste0("QQ plot - ", cf),
subtitle = paste0("lambda = ", lam,
ifelse(lam >= 0.9 & lam <= 1.15,
"  (bien calibrado)",
"  (revisar: ver bloque 13)")),
x = "-log10(p) esperado", y = "-log10(p) observado") +
theme_bw(base_size = 12)
guardar_fig(p_qq, paste0("13_qqplot_", sufijo, ".png"), w = 6.5, h = 6.5)
## --- 13.3 Histograma de p-valores ----------------------------------------
## Complemento imprescindible del QQ plot.
## FORMA ESPERADA: plano (uniforme) con un pico en 0.
## Rampa creciente hacia 1  -> modelo mal especificado.
## Campana centrada en 0,5  -> algo esta muy mal.
png(file.path(DIRS$fig, paste0("13_hist_p_", sufijo, ".png")),
width = 1300, height = 950, res = 170)
hist(tt$P.Value, breaks = 100, col = "#3C4F76", border = NA,
main = paste0("Distribucion de p sin corregir - ", cf), xlab = "p")
dev.off()
## --- 13.4 Manhattan -------------------------------------------------------
## Requiere cromosoma y posicion, que solo existen si se cargo la anotacion.
if (all(c("chr","pos") %in% colnames(tt))) {
man <- data.frame(
CHR = suppressWarnings(as.numeric(gsub("chr", "", tt$chr))),
BP  = suppressWarnings(as.numeric(tt$pos)),
P   = tt$P.Value)
man <- man[stats::complete.cases(man), ]
if (nrow(man) > 1000) {
p_man <- ggplot(man, aes(x = BP/1e6, y = -log10(P),
color = factor(CHR %% 2))) +
geom_point(size = 0.55, alpha = 0.75) +
facet_grid(. ~ CHR, scales = "free_x", space = "free_x", switch = "x") +
scale_color_manual(values = c("#3C4F76", "#9CB4D8")) +
geom_hline(yintercept = -log10(9e-8), linetype = "dashed", color = "#8E3B2E") +
labs(title = paste0("Manhattan plot - ", cf),
subtitle = paste0("Linea: umbral epigenomico 9e-8 | genoma ", PLAT$genoma),
x = "Posicion (Mb)", y = "-log10(p)") +
theme_bw(base_size = 10) +
theme(legend.position = "none", panel.spacing = unit(0.03, "lines"),
strip.background = element_blank(),
axis.text.x = element_blank(), axis.ticks.x = element_blank())
guardar_fig(p_man, paste0("13_manhattan_", sufijo, ".png"), w = 14, h = 5)
}
}
}
## --- 13.5 Heatmap de los top CpG del coeficiente principal ----------------
tt1 <- resultados_dmp[[1]]$tabla
top_cpgs <- rownames(tt1)[seq_len(min(N_TOP_HEATMAP, nrow(tt1)))]
mat_hm <- B_m[top_cpgs, , drop = FALSE]
## Anotacion de columnas: incluir el CHIP es lo que permite detectar
## visualmente si las muestras se agrupan por lote en vez de por biologia.
ann_col <- data.frame(row.names = colnames(mat_hm))
if (!is.null(VAR_PRINCIPAL)) ann_col[[VAR_PRINCIPAL]] <- targets_m[[VAR_PRINCIPAL]]
if (!all(is.na(targets_m$Sentrix_ID)) &&
length(unique(targets_m$Sentrix_ID)) > 1) {
ann_col$Chip <- factor(targets_m$Sentrix_ID)
}
for (cv in COVARIABLES) {
if (cv %in% colnames(targets_m) && !all(is.na(targets_m[[cv]])))
ann_col[[cv]] <- targets_m[[cv]]
}
png(file.path(DIRS$fig, "13_heatmap_top.png"), width = 2000, height = 1800, res = 170)
pheatmap::pheatmap(mat_hm,
annotation_col = if (ncol(ann_col)) ann_col else NA,
scale = "row", show_rownames = nrow(mat_hm) <= 60,
fontsize_row = 6, clustering_method = "ward.D2",
color = colorRampPalette(rev(RColorBrewer::brewer.pal(11, "RdBu")))(100),
main = paste0("Top ", length(top_cpgs),
" CpG (beta, escalado por fila)"))
dev.off()
msg("Heatmap guardado", nivel = "ok")
## --- 13.6 Boxplot del CpG principal ---------------------------------------
## La figura mas honesta: muestra los datos crudos, no un resumen.
cpg1 <- rownames(tt1)[1]
dbox <- data.frame(beta = B_m[cpg1, ], grupo = targets_m[[VAR_PRINCIPAL]])
p_box <- if (es_categorica) {
ggplot(dbox, aes(x = grupo, y = beta, fill = grupo)) +
geom_boxplot(alpha = 0.55, outlier.shape = NA) +
geom_jitter(width = 0.15, size = 2, alpha = 0.85)
} else {
ggplot(dbox, aes(x = grupo, y = beta)) +
geom_point(size = 2, alpha = 0.85, color = "#3C4F76") +
geom_smooth(method = "lm", se = TRUE, color = "#8E3B2E")
}
p_box <- p_box +
labs(title = paste0("Metilacion en ", cpg1),
subtitle = "Datos individuales, sin resumir",
x = VAR_PRINCIPAL, y = "Beta value") +
theme_bw(base_size = 12) + theme(legend.position = "none")
guardar_fig(p_box, "13_boxplot_cpg_top.png", w = 7, h = 5)
}
## --- 14.1 Excel con todas las tablas ----------------------------------------
wb <- openxlsx::createWorkbook()
hojas <- list("Filtrado_sondas" = registro_filtrado,
"QC_muestras"     = qc_muestras)
if (!is.null(cellprops)) hojas[["Composicion_celular"]] <- cellprops
for (cf in names(resultados_dmp))
hojas[[substr(paste0("DMP_", gsub("[^A-Za-z0-9]", "_", cf)), 1, 31)]] <-
utils::head(resultados_dmp[[cf]]$tabla, 5000)
for (cf in names(resultados_dmr))
hojas[[substr(paste0("DMR_", gsub("[^A-Za-z0-9]", "_", cf)), 1, 31)]] <-
resultados_dmr[[cf]]
for (nm in names(resultados_go))
hojas[[substr(nm, 1, 31)]] <- resultados_go[[nm]]
for (nm in names(hojas)) {
openxlsx::addWorksheet(wb, nm)
openxlsx::writeData(wb, nm, hojas[[nm]], rowNames = TRUE)
}
openxlsx::saveWorkbook(wb, file.path(DIRS$tab, "14_RESULTADOS.xlsx"), overwrite = TRUE)
## --- 14.2 Matriz de betas en formato abierto --------------------------------
## Para compartir con quien no usa R, o depositar en un repositorio publico.
utils::write.csv(as.data.frame(betas_clip),
gzfile(file.path(DIRS$proc, "14_matriz_betas.csv.gz")))
## --- 14.3 Objeto unico con todo ----------------------------------------------
saveRDS(list(plataforma = PLAT, targets = targets, betas = betas_clip,
Mvals = Mvals, cellprops = cellprops,
formula = if (exists("formula_txt")) formula_txt else NA,
dmp = resultados_dmp, dmr = resultados_dmr, go = resultados_go,
filtrado = registro_filtrado, qc = qc_muestras,
parametros = mget(c("PREP_SESAME","P_DETECCION","MAX_FALLO_MUESTRA",
"MAX_FALLO_SONDA","MAF_CUT","SNP_DIST",
"FDR_CUT","DELTA_BETA_CUT","SEMILLA"))),
file.path(DIRS$proc, "14_ANALISIS_COMPLETO.rds"))
## --- 14.4 Reporte de texto ---------------------------------------------------
## Un resumen que puedes pegar directamente en el cuaderno de laboratorio o
## como punto de partida de la seccion de Metodos.
rep <- c(
"REPORTE AUTOMATICO DEL ANALISIS DE METILACION",
paste0("Fecha: ", Sys.Date()),
"",
"--- PLATAFORMA ---",
paste0("Array detectado      : ", PLAT$sesame),
paste0("Genoma de referencia : ", PLAT$genoma),
paste0("Anotacion utilizada  : ", PLAT$anno),
"",
"--- MUESTRAS ---",
paste0("IDAT encontrados     : ", length(prefijos) + length(excluir)),
paste0("Excluidas en QC      : ", length(excluir)),
paste0("Analizadas           : ", nrow(targets)),
"",
"--- PROCESAMIENTO ---",
paste0("Preprocesamiento     : sesame prep = '", PREP_SESAME, "'"),
paste0("Sondas iniciales     : ", n_inicial),
paste0("Sondas analizadas    : ", nrow(betas_clip),
" (", round(100*nrow(betas_clip)/n_inicial, 1), "%)"),
paste0("Composicion celular  : ", ifelse(cell_ok, "estimada", "no estimada")),
""
)
if (length(resultados_dmp)) {
rep <- c(rep, "--- MODELO ---", paste0("Formula: ", formula_txt), "")
for (cf in names(resultados_dmp)) {
t <- resultados_dmp[[cf]]$tabla
rep <- c(rep,
paste0("Coeficiente: ", cf),
paste0("  CpG con FDR<", FDR_CUT, "            : ", sum(t$adj.P.Val < FDR_CUT, na.rm = TRUE)),
paste0("  CpG con FDR y |db|>", DELTA_BETA_CUT, "  : ", sum(t$relevante, na.rm = TRUE)),
paste0("  Lambda de inflacion         : ", resultados_dmp[[cf]]$lambda),
paste0("  DMR encontradas             : ",
ifelse(is.null(resultados_dmr[[cf]]), 0, nrow(resultados_dmr[[cf]]))),
"")
}
}
writeLines(rep, file.path(DIR_OUT, "REPORTE.txt"))
cat(paste(rep, collapse = "\n"), "\n")
## --- 14.5 Registro de sesion --------------------------------------------------
writeLines(utils::capture.output(utils::sessionInfo()),
file.path(DIRS$log, paste0("sessionInfo_", Sys.Date(), ".txt")))
msg("ANALISIS TERMINADO. Todo esta en: ", DIR_OUT, nivel = "titulo")
resultados_severidad <- NULL
if (is.null(VAR_SEVERIDAD)) {
msg("VAR_SEVERIDAD es NULL: se omite el bloque 15.", nivel = "warn")
} else if (!length(resultados_dmp)) {
msg("No hay resultados del bloque 10 (DMP): se omite el bloque 15.", nivel = "warn")
} else if (!VAR_SEVERIDAD %in% colnames(targets_m)) {
msg("La columna '", VAR_SEVERIDAD, "' no existe en la tabla de muestras.",
nivel = "warn")
} else {
## --- 15.1 Variables del modelo ---------------------------------------------
tiene_ancestria <- !is.null(COL_ANCESTRIA_LOCAL) &&
COL_ANCESTRIA_LOCAL %in% colnames(targets_m)
if (!tiene_ancestria) {
msg("Sin columna de ancestria local: se prueba solo el efecto principal ",
"de la metilacion (sin interaccion).", nivel = "warn")
}
covs_sev <- unique(c(covs_finales))
covs_sev <- covs_sev[covs_sev %in% colnames(targets_m) &
covs_sev != VAR_SEVERIDAD & covs_sev != COL_ANCESTRIA_LOCAL]
## --- 15.2 Sondas candidatas ---------------------------------------------
## Se juntan las top N_TOP_CPG_SEVERIDAD sondas de CADA coeficiente que se
## probo en el bloque 10 (no solo el principal): una sonda relevante para
## exposicion, ancestria o interaccion diagnostico-ancestria es tan buena
## candidata como una relevante para el diagnostico.
cpgs_sev <- unique(unlist(lapply(resultados_dmp, function(r)
rownames(r$tabla)[seq_len(min(N_TOP_CPG_SEVERIDAD, nrow(r$tabla)))])))
msg("Sondas candidatas (union de todos los coeficientes del bloque 10): ",
length(cpgs_sev), nivel = "titulo")
## --- 15.3 Un modelo por sonda ------------------------------------------
## Con ancestria disponible:
##   severidad ~ beta_cpg * ancestria_local + covariables
##   -> interesa el termino beta_cpg:ancestria_local (¿el efecto de la
##      metilacion sobre la severidad depende de la ancestria local?)
## Sin ancestria: se cae al efecto principal de beta_cpg, como antes.
nucleo_sev <- if (tiene_ancestria) paste0("beta_cpg * ", COL_ANCESTRIA_LOCAL) else "beta_cpg"
formula_sev <- paste("severidad ~", nucleo_sev,
if (length(covs_sev)) paste("+", paste(covs_sev, collapse = " + ")) else "")
ajustar_uno <- function(cpg) {
d <- data.frame(severidad = targets_m[[VAR_SEVERIDAD]],
beta_cpg  = B_m[cpg, ],
targets_m[, unique(c(covs_sev, if (tiene_ancestria) COL_ANCESTRIA_LOCAL)),
drop = FALSE],
check.names = FALSE)
tryCatch({
m <- stats::lm(stats::as.formula(formula_sev), data = d)
s <- summary(m)$coefficients
fila_int <- if (tiene_ancestria) grep(":", rownames(s), value = TRUE)[1] else NA
data.frame(
CpG          = cpg,
estimado_beta = if ("beta_cpg" %in% rownames(s)) s["beta_cpg", "Estimate"] else NA,
p_beta        = if ("beta_cpg" %in% rownames(s)) s["beta_cpg", 4] else NA,
estimado_int  = if (!is.na(fila_int)) s[fila_int, "Estimate"] else NA,
p_int         = if (!is.na(fila_int)) s[fila_int, 4] else NA)
}, error = function(e) NULL)
}
tabla_sev <- do.call(rbind, lapply(cpgs_sev, ajustar_uno))
if (is.null(tabla_sev) || !nrow(tabla_sev)) {
msg("No se pudo ajustar ningun modelo de severidad (revisa datos faltantes).",
nivel = "warn")
} else {
## FDR por separado para el efecto principal y para la interaccion: son
## dos preguntas distintas, cada una con su propia correccion.
tabla_sev$fdr_beta <- stats::p.adjust(tabla_sev$p_beta, method = "BH")
if (tiene_ancestria) tabla_sev$fdr_int <- stats::p.adjust(tabla_sev$p_int, method = "BH")
tabla_sev <- tabla_sev[order(if (tiene_ancestria) tabla_sev$p_int else tabla_sev$p_beta), ]
if (tiene_ancestria) {
msg("Sondas con interaccion metilacion x ancestria FDR < ", FDR_CUT, ": ",
sum(tabla_sev$fdr_int < FDR_CUT, na.rm = TRUE))
} else {
msg("Sondas con efecto principal FDR < ", FDR_CUT, ": ",
sum(tabla_sev$fdr_beta < FDR_CUT, na.rm = TRUE))
}
print(utils::head(tabla_sev, 8))
write.csv(tabla_sev, file.path(DIRS$tab, "15_severidad_x_metilacion_x_ancestria.csv"),
row.names = FALSE)
## --- 15.4 Figura de la sonda con interaccion mas fuerte -----------------
## Una linea de regresion por tercil de ancestria: si las lineas tienen
## pendientes distintas, esa es la interaccion vista a ojo.
cpg_top_sev <- tabla_sev$CpG[1]
d_plot <- data.frame(beta = B_m[cpg_top_sev, ], severidad = targets_m[[VAR_SEVERIDAD]])
if (tiene_ancestria) {
d_plot$ancestria_grupo <- cut(targets_m[[COL_ANCESTRIA_LOCAL]], breaks = 3,
labels = c("Ancestria baja", "Ancestria media", "Ancestria alta"))
p_sev <- ggplot(d_plot, aes(x = beta, y = severidad, color = ancestria_grupo)) +
geom_point(size = 2.2, alpha = 0.8) +
geom_smooth(method = "lm", se = FALSE) +
labs(title = paste0("Severidad vs. metilacion en ", cpg_top_sev, ", por ancestria local"),
subtitle = paste0("Interaccion beta_cpg x ", COL_ANCESTRIA_LOCAL,
": pendientes distintas = evidencia de interaccion"),
x = "Beta value", y = VAR_SEVERIDAD, color = NULL) +
theme_bw(base_size = 12)
} else {
p_sev <- ggplot(d_plot, aes(x = beta, y = severidad)) +
geom_point(size = 2.4, alpha = 0.8, color = "#3C4F76") +
geom_smooth(method = "lm", se = TRUE, color = "#8E3B2E") +
labs(title = paste0("Severidad vs. metilacion en ", cpg_top_sev),
subtitle = "Sin ajuste por ancestria local (columna no disponible)",
x = "Beta value", y = VAR_SEVERIDAD) +
theme_bw(base_size = 12)
}
guardar_fig(p_sev, "15_severidad_top_cpg.png", w = 7.5, h = 5.5)
resultados_severidad <- tabla_sev
}
saveRDS(resultados_severidad, file.path(DIRS$proc, "15_resultados_severidad.rds"))
}
# ENTRA : 10_resultados_DMP.rds, VAR_SEVERIDAD y COL_ANCESTRIA_LOCAL del bloque 0
# ENTRA : 10_resultados_DMP.rds, VAR_SEVERIDAD y COL_ANCESTRIA_LOCAL del bloque 0
# SALE  : 15_severidad_x_metilacion_x_ancestria.csv, 15_severidad_top_cpg.png
# ENTRA : 10_resultados_DMP.rds, VAR_SEVERIDAD y COL_ANCESTRIA_LOCAL del bloque 0
# SALE  : 15_severidad_x_metilacion_x_ancestria.csv, 15_severidad_top_cpg.png
# VERIFICAR: (1) revisa fdr_int (no solo fdr_beta): es la pregunta central del
# ENTRA : 10_resultados_DMP.rds, VAR_SEVERIDAD y COL_ANCESTRIA_LOCAL del bloque 0
# SALE  : 15_severidad_x_metilacion_x_ancestria.csv, 15_severidad_top_cpg.png
# VERIFICAR: (1) revisa fdr_int (no solo fdr_beta): es la pregunta central del
#            objetivo 3; (2) el signo de estimado_int tiene sentido biologico;
# ENTRA : 10_resultados_DMP.rds, VAR_SEVERIDAD y COL_ANCESTRIA_LOCAL del bloque 0
# SALE  : 15_severidad_x_metilacion_x_ancestria.csv, 15_severidad_top_cpg.png
# VERIFICAR: (1) revisa fdr_int (no solo fdr_beta): es la pregunta central del
#            objetivo 3; (2) el signo de estimado_int tiene sentido biologico;
#            (3) en la figura, si las rectas por grupo de ancestria son casi
# ENTRA : 10_resultados_DMP.rds, VAR_SEVERIDAD y COL_ANCESTRIA_LOCAL del bloque 0
# SALE  : 15_severidad_x_metilacion_x_ancestria.csv, 15_severidad_top_cpg.png
# VERIFICAR: (1) revisa fdr_int (no solo fdr_beta): es la pregunta central del
#            objetivo 3; (2) el signo de estimado_int tiene sentido biologico;
#            (3) en la figura, si las rectas por grupo de ancestria son casi
#            paralelas, la interaccion probablemente no es real aunque el p
# 0.1 Rutas
DIR_IDAT   <- "C:/Users/camip/OneDrive/Desktop/archivos idar"  # <-- EDITADO
RECURSIVO  <- TRUE                             # buscar en subcarpetas
DIR_OUT    <- "C:/Users/camip/OneDrive/Desktop/RESULTADOS_idat" # <-- EDITADO
# Entrada alternativa: si no tengo los IDAT sino una matriz de betas ya
# procesada (la que me pasa un colaborador, o la de una serie publica), pongo
# aqui su ruta: .rds o .csv con sondas en filas y muestras en columnas.
# Los paquetes de analisis posteriores (limma, DMRcate, missMethyl) trabajan
# sobre esta matriz, no sobre los IDAT, asi que el pipeline sigue igual desde
# el bloque 6 (Peters et al., Epigenetics & Chromatin 2015;8:6;
# Phipson et al., Bioinformatics 2016;32:286-8).
FILE_BETAS <- NULL          # ej: "C:/ruta/betas.rds"   o   NULL
PLATAFORMA_MANUAL <- NULL   # "HM450" | "EPIC" | "EPICv2"; obligatorio con FILE_BETAS
# Tabla de anotacion de sondas alternativa, si no tengo los paquetes de Illumina.
# Columnas: name, chromosome, position, gene.symbol, relation.to.island y,
# opcional, snp.exclude (sondas sobre SNP frecuentes, Zhou et al., NAR 2017;45:e22).
FILE_ANOTACION <- NULL      # .rds o .csv   o   NULL
# Armonizacion del genoma de referencia (bloque 6b).
# El array trae sus coordenadas en un build concreto (450K y EPIC v1 en hg19,
# EPIC v2 en hg38) y la ancestria local imputada en TOPMed sale en hg38: para
# cruzar ambas capas tienen que estar en el mismo sistema de coordenadas.
# Convierto con rtracklayer::liftOver (Lawrence et al., PLoS Comput Biol
# 2013;9:e1003118) y un archivo chain de UCSC (Kent et al., Genome Research
# 2002;12:996-1006). No confundir con sesame::mLiftOver(), que traduce
# identificadores de sonda entre plataformas, no coordenadas entre builds.
GENOMA_OBJETIVO <- NULL     # "hg19" | "hg38" | NULL (dejo el nativo del array)
FILE_CHAIN      <- NULL     # ej: "C:/ruta/hg19ToHg38.over.chain"
# SampleSheet, una fila por muestra. NULL si no tengo ninguna.
FILE_SHEET <- "C:/Users/camip/OneDrive/Desktop/archivos idar/SampleSheet_GSE318173.csv"  # <-- EDITADO
# Enlace fila de la hoja con el par de IDAT: Sentrix_ID+Position, Basename,
# o columna que coincide con el nombre del archivo IDAT.
COL_SENTRIX_ID  <- NULL                # <-- EDITADO: uso COL_IDAT_NAME en su lugar
COL_SENTRIX_POS <- NULL                # <-- EDITADO
COL_BASENAME    <- NULL                # ej: "Basename"
COL_IDAT_NAME   <- "GSM"               # <-- EDITAR: nombre de tu columna con el GSM (ej. GSM9487955)
COL_ID <- "Sample_Name"                # nombre a mostrar; NULL -> nombre del IDAT
# 0.2 El modelo: que quiero comparar (columnas de la SampleSheet)
VAR_PRINCIPAL <- "Grupo"               # <-- EDITADO: PD vs Control (columna del SampleSheet)
NIVEL_REFERENCIA <- "Control"          # nivel de referencia si es categorica; NULL si continua
COVARIABLES <- c("Edad", "Sexo")       # <-- EDITADO
VAR_INTERACCION <- NULL                # ej: "Exposicion" ; interaccion con la principal
CONTRASTES_EXTRA <- character(0)       # otros coeficientes del mismo modelo a testear
# 0.3 Caracteristicas de las muestras
# TEJIDO: decide si se estima composicion celular y con que referencia
# "blood" (12 tipos) | "blood_6" (6 tipos) | "cordblood" | "propio" (uso mi
# tabla de FILE_REF_CELULAR) | "otro" (sin referencia) | "ninguno"
TEJIDO <- "blood"                      # LARGE-PD es sangre periferica: dejo "blood"
# Referencia celular propia, para tejidos sin paquete FlowSorted o para usar una
# tabla publicada distinta: sondas del panel en filas, tipos celulares en
# columnas, con el beta medio de cada tipo puro (.rds o .csv).
# Si la doy, manda sobre los paquetes. Con TEJIDO = "propio" es obligatoria.
FILE_REF_CELULAR  <- NULL              # ej: "C:/ruta/referencia_celular.rds"
MIN_PANEL_CELULAR <- 0.6               # fraccion minima del panel que debe sobrevivir
# "mixto": ambos sexos, se eliminan chrX/chrY. "unico": puedo conservarlos.
SEXO_MUESTRAS <- "mixto"               # <-- EDITAR
ELIMINAR_XY   <- TRUE                  # recomendado TRUE salvo justificacion
COL_SEXO <- "Sexo"                     # sexo declarado, para el bloque 4; valores M/F
# 0.4 Parametros del procesamiento
PREP_SESAME      <- "QCDPB"  # codigo sesame: Q=mascara calidad, C=infiere canal,
P_DETECCION      <- 0.05     # umbral del p de deteccion
MAX_FALLO_MUESTRA<- 0.05     # descarta MUESTRA si falla >5% de sondas
MAX_FALLO_SONDA  <- 0.10     # descarta SONDA si falla en >10% muestras
MAF_CUT          <- 0.05     # frecuencia alelica minima para filtrar SNP
SNP_DIST         <- 5        # distancia (pb) sonda-SNP para filtrar
FILTRAR_CROSSHYB <- TRUE     # eliminar sondas de reactividad cruzada
COLAPSAR_REPLICAS<- TRUE     # colapsar replicas de sonda (solo EPICv2)
IMPUTAR_NA       <- TRUE     # TRUE = imputar por kNN ; FALSE = eliminar filas
# Filtros y validaciones del pipeline de referencia (Lie et al., Ann Clin
# Transl Neurol 2025; wateRmelon::pfilter, Pidsley et al., BMC Genomics
# 2013;14:293). El de perlas es el que mas sondas elimina en ese trabajo:
# 14.621 frente a 4.752 del filtro de deteccion.
MIN_PERLAS        <- 3       # enmascaro sondas medidas por menos de 3 perlas
BETA_CONSTITUTIVO <- c(0.025, 0.975)  # quito sondas con beta medio fuera del rango
VALIDAR_NORMALIZACION <- TRUE          # error estandar en DMR improntadas
# La deconvolucion se degrada si el filtrado elimina sondas del panel, asi que
# por defecto la estimo ANTES de filtrar, como el pipeline de referencia
DECONV_ANTES_DE_FILTRAR <- TRUE
FDR_CUT          <- 0.05     # umbral tras Benjamini-Hochberg
DELTA_BETA_CUT   <- 0.05     # magnitud minima interpretable (5% de metilacion)
N_TOP_HEATMAP    <- 50
N_SONDAS_PCA     <- 5000     # sondas mas variables usadas en el PCA
# Legibilidad del PCA cuando crece el numero de muestras. Con 23 muestras se
# puede etiquetar cada punto y colorear por cualquier variable; con 200 no: una
# leyenda de 200 niveles ocupa toda la figura y ggplot falla con "Viewport has
# zero dimension(s)", y 200 etiquetas de ggrepel tapan los puntos. Estos dos
# limites hacen que el mismo script funcione en la prueba piloto y en la cohorte
# completa sin tener que tocarlo.
MAX_ETIQUETAS_PCA <- 60   # por encima de esto, el PCA se dibuja sin etiquetas
MAX_NIVELES_COLOR <- 25   # variable con mas niveles: no se usa para colorear
N_PC_PARES       <- 5        # dibujo todos los pares de estos primeros PC
